{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension (fixture)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--disable-extensions",
        "--new-window",
        "--user-data-dir=${workspaceFolder}/.vscode-test/debug-profile",
        "${workspaceFolder}/test-fixtures/basic",
        "${workspaceFolder}/test-fixtures/basic/hello.sol"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "compile-extension"
    },
    {
      "name": "Debug Integration Tests",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--disable-extensions",
        "--new-window",
        "${workspaceFolder}/test-fixtures/basic",
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--extensionTestsPath=${workspaceFolder}/dist/test/runner"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "compile-extension"
    },
    {
      "name": "Debug Extension (stay open)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--disable-extensions",
        "--new-window",
        "${workspaceFolder}/test-fixtures",
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--extensionTestsPath=${workspaceFolder}/dist/test/stay-open"
      ],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "compile-extension"
    }
  ]
}
